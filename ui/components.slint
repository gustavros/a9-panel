// Building blocks matching ATK Hub (sizes taken from the page's computed CSS, in px).

export global Theme {
    out property <color> bg: #edeef3;
    out property <color> k04: #0000000a;
    out property <color> k08: #00000014;
    out property <color> k12: #0000001f;
    out property <color> k16: #00000029;
    out property <color> k20: #00000033;
    out property <color> k25: #00000040;
    out property <color> k30: #0000004d;
    out property <color> k55: #0000008c;
    out property <color> k60: #00000099;
    out property <color> k85: #000000d9;
    out property <color> panel: #ffffffcc;
    out property <color> runway: #e4e7ed;
    out property <color> input-border: #dcdfe6;
    out property <color> orange: #ff6900;
    out property <color> error: #ff4d4f;
    out property <color> success: #2fcb64;
    // polling bar gradients (the Hub's rate-blue / rate-orange / rate-red classes)
    out property <brush> rate-blue: @linear-gradient(90deg, #91d3f9 0%, #0090ee 100%);
    out property <brush> rate-orange: @linear-gradient(90deg, #2a7dd4cc 0%, #ff8420cc 100%);
    out property <brush> rate-red: @linear-gradient(90deg, #fe7f1bcc 0%, #e60000cc 100%);
}

// Bold the way browsers fake it when the font only has a regular weight: a thin outline in the same color.
export component Strong inherits Text {
    font-weight: 700;
    stroke: self.color;
    stroke-width: 0.6px;
    stroke-style: outside;
}

export component Icon inherits Image {
    width: 20px;
    height: 20px;
    colorize: Theme.k85;
    image-fit: contain;
}

// Sidebar item: 45px, radius 8, padding 12/16, 20px icon, 12px gap, text 14/500.
export component NavItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> active;
    callback clicked();
    height: 45px;
    border-radius: 8px;
    background: root.active ? Theme.k08 : (ta.has-hover ? Theme.k04 : transparent);
    animate background { duration: 150ms; }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        Icon { source: root.icon; y: (parent.height - self.height) / 2; }
        Text {
            text: root.label;
            color: Theme.k85;
            font-size: 14px;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Hub secondary button: k08 background, radius 6, padding 8/15, height 32, text 14/500.
export component HubButton inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    callback clicked();
    height: 32px;
    border-radius: 6px;
    background: root.primary
        ? (root.enabled ? (ta.has-hover ? #262626 : #000000) : Theme.k25)
        : (ta.has-hover && root.enabled ? Theme.k12 : Theme.k08);
    animate background { duration: 150ms; }
    opacity: root.enabled || root.primary ? 1.0 : 0.5;
    HorizontalLayout {
        padding-left: 15px;
        padding-right: 15px;
        spacing: 6px;
        alignment: center;
        if root.has-icon: Icon {
            source: root.icon;
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            colorize: root.primary ? #ffffff : Theme.k85;
        }
        Text {
            text: root.label;
            color: root.primary ? #ffffff : Theme.k85;
            font-size: 14px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
}

// Element Plus segmented control: k08 background, radius 6, padding 2, 28px items with radius 4.
export component Segmented inherits Rectangle {
    in property <[string]> items;
    in property <int> selected: -1;
    in property <bool> enabled: true;
    in property <brush> selected-bg: #000000;
    in property <color> selected-text: #ffffff;
    in property <length> font: 14px;
    callback picked(int);
    height: 32px;
    border-radius: 6px;
    background: Theme.k08;
    opacity: root.enabled ? 1.0 : 0.6;
    HorizontalLayout {
        padding: 2px;
        for item[i] in root.items: Rectangle {
            border-radius: 4px;
            background: i == root.selected ? root.selected-bg : (seg-ta.has-hover && root.enabled ? Theme.k04 : transparent);
            animate background { duration: 200ms; }
            Text {
                text: item;
                color: i == root.selected ? root.selected-text : Theme.k55;
                font-size: root.font;
            }
            seg-ta := TouchArea {
                mouse-cursor: root.enabled ? pointer : default;
                clicked => { if (root.enabled && i != root.selected) { root.picked(i); } }
            }
        }
    }
}

// Vertical segmented control (sensor mode): radius 5, 28px items with radius 3, selected in black.
export component VSegmented inherits Rectangle {
    in property <[string]> items;
    in property <int> selected: -1;
    in property <bool> enabled: true;
    callback picked(int);
    border-radius: 5px;
    background: Theme.k08;
    opacity: root.enabled ? 1.0 : 0.6;
    VerticalLayout {
        padding: 2px;
        for item[i] in root.items: Rectangle {
            height: 28px;
            border-radius: 3px;
            background: i == root.selected ? #000000 : (v-ta.has-hover && root.enabled ? Theme.k04 : transparent);
            animate background { duration: 200ms; }
            Text { text: item; color: i == root.selected ? #ffffff : Theme.k55; font-size: 14px; }
            v-ta := TouchArea {
                mouse-cursor: root.enabled ? pointer : default;
                clicked => { if (root.enabled && i != root.selected) { root.picked(i); } }
            }
        }
    }
}

// el-switch: 50x24, radius 12, off k25, on black, 18px white knob.
export component Switch inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    width: 50px;
    height: 24px;
    border-radius: 12px;
    background: root.checked ? #000000 : Theme.k25;
    opacity: root.enabled ? 1.0 : 0.5;
    animate background { duration: 200ms; }
    Rectangle {
        width: 18px;
        height: 18px;
        y: 3px;
        x: root.checked ? root.width - self.width - 3px : 3px;
        border-radius: 9px;
        background: #ffffff;
        animate x { duration: 200ms; easing: ease-out; }
    }
    TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if (root.enabled) { root.toggled(!root.checked); } }
    }
}

// el-slider: 6px #e4e7ed runway, black bar, 12px white knob with a 3px k85 border.
export component HubSlider inherits Rectangle {
    in property <int> min: 10;
    in property <int> max: 42000;
    in property <int> value: 800;
    in property <bool> enabled: true;
    callback changed(int);
    callback released();
    height: 18px;
    property <float> ratio: clamp((root.value - root.min) / (root.max - root.min), 0, 1);
    function pick(x: length) {
        root.changed(root.min + clamp(x / root.width, 0, 1) * (root.max - root.min));
    }
    Rectangle {
        y: (parent.height - self.height) / 2;
        width: 100%;
        height: 6px;
        border-radius: 3px;
        background: Theme.runway;
        Rectangle {
            x: 0;
            width: parent.width * root.ratio;
            height: parent.height;
            border-radius: 3px;
            background: #000000;
        }
    }
    Rectangle {
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: #ffffff;
        border-width: 3px;
        border-color: Theme.k85;
        y: (parent.height - self.height) / 2;
        x: root.width * root.ratio - self.width / 2;
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { root.pick(self.mouse-x); }
            if (e.kind == PointerEventKind.up) { root.released(); }
        }
        moved => { root.pick(self.mouse-x); }
    }
}

// Small el-input-number: white, radius 6, 1px #dcdfe6 border, 24px, 12px text, arrows on the right.
export component NumberBox inherits Rectangle {
    in property <int> value;
    in property <int> step: 10;
    in property <int> min: 0;
    in property <int> max: 100000;
    in property <bool> enabled: true;
    callback edited(int);
    callback submitted(int);
    width: 92px;
    height: 24px;
    border-radius: 6px;
    background: #ffffff;
    border-width: 1px;
    border-color: input.has-focus ? #000000 : Theme.input-border;
    opacity: root.enabled ? 1.0 : 0.6;
    function bump(d: int) {
        root.submitted(clamp(root.value + d, root.min, root.max));
    }
    HorizontalLayout {
        padding-left: 8px;
        input := TextInput {
            text: root.value;
            input-type: number;
            font-size: 12px;
            color: #000000;
            enabled: root.enabled;
            vertical-alignment: center;
            single-line: true;
            edited => { if (self.text != "") { root.edited(self.text.to-float()); } }
            accepted => { root.submitted(clamp(self.text.to-float(), root.min, root.max)); }
        }
        VerticalLayout {
            width: 24px;
            Rectangle {
                background: up.has-hover ? Theme.k04 : transparent;
                Icon { source: @image-url("assets/icons/chevron.svg"); width: 10px; height: 10px; colorize: Theme.k60; transform-rotation: -90deg; }
                up := TouchArea { enabled: root.enabled; clicked => { root.bump(root.step); } }
            }
            Rectangle {
                background: down.has-hover ? Theme.k04 : transparent;
                Icon { source: @image-url("assets/icons/chevron.svg"); width: 10px; height: 10px; colorize: Theme.k60; transform-rotation: 90deg; }
                down := TouchArea { enabled: root.enabled; clicked => { root.bump(-root.step); } }
            }
        }
    }
}

// Section card (like "Battery Life Calculation"): 80% white, radius 8, header padding 14/20, title 16/700.
export component TitleCard inherits Rectangle {
    in property <string> title;
    in property <image> icon;
    in property <bool> has-icon: false;
    background: Theme.panel;
    border-radius: 8px;
    VerticalLayout {
        HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 14px;
            padding-bottom: 14px;
            spacing: 8px;
            height: 52px;
            if root.has-icon: Icon { source: root.icon; width: 16px; height: 16px; y: (parent.height - self.height) / 2; }
            Strong { text: root.title; color: Theme.k85; font-size: 16px; font-weight: 700; vertical-alignment: center; }
        }
        @children
    }
}

// Parameter row: k04 background, radius 8, padding 16/24, name 14/500, hint 12 k60, control on the right.
export component ParamRow inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    background: Theme.k04;
    border-radius: 8px;
    // grows with the content (a row can hold several lines of controls)
    min-height: max(68px, body.min-height);
    body := HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            Text { text: root.label; color: Theme.k85; font-size: 14px; font-weight: 500; }
            if root.hint != "": Text { text: root.hint; color: Theme.k60; font-size: 12px; wrap: word-wrap; }
        }
        HorizontalLayout {
            alignment: end;
            VerticalLayout {
                alignment: center;
                @children
            }
        }
    }
}

export component PageTitle inherits HorizontalLayout {
    in property <string> title;
    height: 32px;
    spacing: 12px;
    Strong { text: root.title; color: Theme.k85; font-size: 16px; font-weight: 700; vertical-alignment: center; }
    Rectangle { horizontal-stretch: 1; }
    @children
}

// Text field like the Hub's el-input: white, radius 6, 1px #dcdfe6 border (black when focused), 32px.
export component TextBox inherits Rectangle {
    in property <string> text;
    in property <string> placeholder;
    callback submitted(string);
    height: 32px;
    border-radius: 6px;
    background: #ffffff;
    border-width: 1px;
    border-color: field.has-focus ? #000000 : Theme.input-border;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        field := TextInput {
            text: root.text;
            font-size: 13px;
            color: #000000;
            single-line: true;
            vertical-alignment: center;
            accepted => { root.submitted(self.text); }
        }
    }
    if field.text == "": Text {
        x: 12px;
        text: root.placeholder;
        color: Theme.k30;
        font-size: 13px;
        vertical-alignment: center;
        height: parent.height;
    }
}
